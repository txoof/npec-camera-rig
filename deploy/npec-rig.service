[Unit]
Description=NPEC Camera Rig web console
After=network.target time-sync.target
# Start once the clock has the network time (#62). After a power cut the Pi's clock can be old
# until then; an app started on it would record the photos missed while the power was off as
# missed behind a slow photo, and their times wrong. Needs systemd-time-wait-sync enabled
# (README.md); time-wait-limit.conf stops the wait after 120 s, so with no network the app
# still starts, on the clock it has.
Wants=time-sync.target
# Never give up restarting (#62): a running experiment resumes as soon as the app is back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/npec_camera_rig
ExecStart=/home/pi/npec_camera_rig/.venv/bin/uvicorn npec_rig.app:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 5
# Restarted after any exit, not only a crash: an app that stops by itself would stop the
# experiment's photos without a word (#62). `systemctl stop` still stops it.
Restart=always
RestartSec=5
# SIGTERM (the systemd default, stated on purpose) lets the app close the camera cleanly. Never
# SIGINT: a second one skips the app's shutdown and leaves the camera open (#139).
KillSignal=SIGTERM
# Longer than the app's wait for the camera to go idle at shutdown (SHUTDOWN_CAMERA_IDLE_WAIT_S,
# 120 s), so a stop during a long still does not kill the camera program mid-call.
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
