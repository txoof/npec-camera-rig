[Unit]
Description=NPEC Camera Rig web console
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/npec_camera_rig
ExecStart=/home/pi/npec_camera_rig/.venv/bin/uvicorn npec_rig.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
