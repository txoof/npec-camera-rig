/* ---------------------------------------------------------------------------
   AprilTag 36h11 renderer -- turns a decoded tag id into the two solids a
   multi-material printer needs for a clean one-pass two-color print: no
   glue, no manual filament swap, no finishing step. Meant to be `use`d from
   another design (e.g. apriltag_corner_mount.scad) alongside its own
   `color()` calls, not run standalone.

   Bit data comes from `apriltags-36h11-1-499.scad` (generated by
   apriltag-gen's `export-scad`, ids 1..499, TAG_36H11_BITS[id] indexed
   directly by id -- index 0 is an empty placeholder, not a real tag). That
   data is the interior payload only (6x6), 0 = black, 1 = white, border
   already excluded -- see apriltag_gen/tags.py's payload_bits() docstring.

   AprilTag convention, per Aaron 2026-09-28: the black portion is raised --
   the fixed one-module black border ring plus every payload cell whose bit
   is 0. The border ring itself carries no per-tag data (moms_apriltag's
   output has it solid black for every id in every 36h11 tag), so it is
   drawn from geometry alone, not from the bit array.

   Two solids, not one, and never unioned with each other -- this is what
   makes a colored 3MF export possible at all:
     - `april_tag_base()` -- the white background plate, the full edge x edge
       square, Z in [0, thickness]. Does not depend on the tag id.
     - `april_tag_pattern()` -- the raised black layer: border ring + payload
       cells where bit == 0, Z in [thickness, thickness + raise_h], sharing
       a flush face with the base's top (no gap, no overlap).

   Coordinate convention: centred on X = Y = 0 in the tag's own plane, Z = 0
   at the base's underside. Module grid: n = payload width + 2 (border on
   both sides) = 8 for 36h11.

   Verification: orientation (which corner is which) is exactly the kind of
   silently-wrong-not-loud risk this project's governing principle warns
   about, so it does not stop at "the file parses." Checked for id 1 by
   exporting `april_tag_pattern()` alone to STL and testing point containment
   (trimesh) at each of the 8x8 cell centres against tags.py's own
   tag_bits('tag36h11', 1) -- an exact match, border and all, not just a
   visual eyeball. Re-run that check if this file's row/col mapping, or the
   payload-vs-border split, ever changes.

   REV 1.0: initial. First draft unioned a difference()-built border frame
     with the payload cells as siblings before extruding; that union()
     silently dropped the frame entirely (confirmed by isolating it -- the
     frame alone rendered fine, but as soon as it was union()'d with even
     one sibling square, it vanished from the CGAL render with no warning or
     error). Reworked so the black area is a single difference(): the full
     square minus only the white cells, since the border ring, being outside
     the payload's row/col range, is never subtracted and stays solid with
     no separate frame primitive needed.
   --------------------------------------------------------------------------- */

include <apriltags-36h11-1-499.scad>

/* [Tag] */
tag_id   = 1;    // which 36h11 id to preview  [1:499]
tag_edge = 50;   // outer black-square width, mm -- matches apriltag-gen's own --size convention
thickness = 1.0; // base plate height, mm  [0.4:0.1:3]
raise_h   = 0.6; // raised black layer height above the base, mm  [0.2:0.1:2]

/* [Colors] */
base_color  = "White";
raise_color = "Black";

/* [Render] */
$fn = $preview ? 16 : 32;
eps = 0.01;

// ---------------------------------------------------------------------------

module april_tag_base(edge = tag_edge, thickness = thickness) {
    linear_extrude(thickness)
        square(edge, center = true);
}

module april_tag_pattern(id = tag_id, edge = tag_edge, thickness = thickness, raise_h = raise_h) {
    bits = TAG_36H11_BITS[id];
    n    = len(bits) + 2;
    cell = edge / n;

    translate([0, 0, thickness])
        linear_extrude(raise_h)
            translate([-edge / 2, -edge / 2])
                // Black area = the full square minus the white cells only.
                // The border ring is outside the payload's row/col range, so
                // it is never subtracted and stays solid automatically -- no
                // separate frame primitive needed. (A union() of a
                // difference()-built frame with sibling squares was tried
                // first and silently dropped the frame entirely; this
                // single-difference form sidesteps that.)
                difference() {
                    square(edge);
                    // payload cells where the bit is 1 (white); row 0 is the
                    // tag's own top row as generated, placed toward +Y here
                    for (row = [0 : len(bits) - 1], col = [0 : len(bits[0]) - 1])
                        if (bits[row][col] == 1)
                            translate([(col + 1) * cell, (n - 2 - row) * cell])
                                square(cell);
                }
}

module april_tag(id = tag_id, edge = tag_edge, thickness = thickness, raise_h = raise_h,
                  base_color = base_color, raise_color = raise_color) {
    // standalone preview only -- a real two-color export colours the two
    // halves at the call site instead, see the file header
    color(base_color)  april_tag_base(edge = edge, thickness = thickness);
    color(raise_color) april_tag_pattern(id = id, edge = edge, thickness = thickness, raise_h = raise_h);
}

april_tag();
